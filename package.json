{
  "name": "@dingyi222666/yakumo-rolldown",
  "version": "1.0.0",
  "description": "Rolldown support for Yakumo",
  "keywords": [
    "build",
    "cli",
    "monorepo",
    "rolldown",
    "script",
    "workspace"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dingyi222666/yakumo-rolldown.git"
  },
  "files": [
    "lib"
  ],
  "type": "module",
  "main": "lib/index.js",
  "typings": "lib/index.d.ts",
  "exports": {
    ".": "./lib/index.js",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "lint": "oxlint",
    "format": "oxfmt"
  },
  "dependencies": {
    "globby": "^14.1.0",
    "js-yaml": "^4.1.0",
    "schemastery": "^3.18.0",
    "tsconfig-utils": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "rolldown": "^1.2.15",
    "typescript": "^7.0.2",
    "yakumo": "^3.2.1"
  },
  "peerDependencies": {
    "rolldown": "*",
    "typescript": "*",
    "yakumo": "^3.2.1"
  },
  "packageManager": "yarn@4.18.1",
  "cordis": {
    "inject": [
      "yakumo"
    ]
  }
}
